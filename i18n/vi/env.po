#: i18n.clean_des
msgid "Clean environment, containing only variables from -s"
msgstr "Chỉ truyền lại các biến môi trường từ -s"

#: i18n.exenotfound
#, object-pascal-format
msgid "%s not found - any typo here?"
msgstr "không thấy %s - có sai chính tả không?"

#: i18n.get_des
msgid "Get environment variables"
msgstr "Đọc biến môi trường"

#: i18n.noprogspecified
msgid "No program was specified. This program will not set variables for your current shell/program instance and even user/system-wide."
msgstr ""

#: i18n.processexit
#, object-pascal-format
msgid "Process exited with the following message: %s"
msgstr "Tiến trình đã thoát với thông điệp: %s"

#: i18n.program_bonus_help
msgid "If no argument is specified, all existing environment variables will be printed.\r\n"
"Otherwise, a program must be specified.\r\n"
"Unless otherwise specified via -c, all existing variables will not be removed for the upcoming process."
msgstr ""

#: i18n.program_desc
msgid "Launch processes with specified (and maybe modified) environment variables."
msgstr ""

#: i18n.set_des
msgid "Set environment variables"
msgstr "Đặt biến môi trường"

#: i18n.unset_des
msgid "Unset environment variables"
msgstr "Xóa biến môi trường"

